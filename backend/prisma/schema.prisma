datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UserType {
  USER
  HOST
  AGENCY_OWNER
  BD_AGENT
  COIN_SELLER
  MERCHANT
}

enum OTPPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

enum HostType {
  LIVE_HOST
  AUDIO_HOST
  BOTH
}

enum HostStatus {
  APPLIED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum AgencyType {
  LIVE_AGENCY
  AUDIO_AGENCY
  HYBRID
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum BDTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum BDInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CoinSellerStatus {
  ACTIVE
  SUSPENDED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum WalletLedgerType {
  RECHARGE
  GIFT_SENT
  GIFT_RECEIVED
  WITHDRAWAL
  P2P_ESCROW_LOCK
  P2P_ESCROW_RELEASE
  ADMIN_ADJUSTMENT
  SWAP
  RESELLER_ALLOCATION
}

enum RechargeStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OfflineRechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoinRefundStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum EscrowStatus {
  LOCKED
  RELEASED
  DISPUTED
  CANCELLED
}

enum RoomType {
  LIVE_VIDEO
  AUDIO_PARTY
}

enum RoomCategory {
  MUSIC
  CHAT
  GAMING
}

enum RoomStatus {
  LIVE
  ENDED
  CLOSED_BY_ADMIN
}

enum GiftCategory {
  POPULAR
  LUXURY
  VIP
  AUDIO
}

enum AssetType {
  FRAME
  ENTRY_EFFECT
  CHAT_BUBBLE
  BADGE
  VEHICLE
  SOUND_EFFECT
}

enum AssetSubcategory {
  STATIC
  ANIMATED_SVGA
  MP4_VIDEO
  MP3_AUDIO
}

enum RoomAvailability {
  BOTH
  LIVE_ONLY
  AUDIO_ONLY
}

enum GameKey {
  SLOTS
  ROCKET
  WHEEL
  DICE
}

enum GameRoundStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PKStatus {
  COUNTDOWN
  ACTIVE
  ENDED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationActionType {
  MUTE_MIC
  KICK
  BAN_ROOM
  SUSPEND_ACCOUNT
}

enum RestrictionType {
  BAN
  MUTE
  MIC_BLOCK
  WITHDRAWAL_BLOCK
}

// ==========================================
// SYSTEM FOUNDATION
// ==========================================

model SystemInitCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
  status    String   @default("OK")
}

// ==========================================
// DOMAIN A & B: USER, IDENTITY & AUTHENTICATION
// ==========================================

model User {
  id                String     @id @default(uuid())
  phone             String?    @unique
  email             String?    @unique
  username          String     @unique
  passwordHash      String?
  status            UserStatus @default(ACTIVE)
  userType          UserType   @default(USER)
  countryCode       String     @default("US")
  dob               DateTime?
  gender            String?
  bio               String?
  avatarUrl         String?
  isUnderageBlocked Boolean    @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  profile                  UserProfile?
  sessions                 UserSession[]
  devices                  UserDevice[]
  wallet                   Wallet?
  hostProfile              HostProfile?
  hostApplications         HostApplication[]
  ownedAgencies            Agency[]            @relation("AgencyOwner")
  agencyMemberships        AgencyMember[]
  managedBDCenters         BDCenter[]          @relation("BDManager")
  bdInvites                BDInvite[]
  coinSeller               CoinSeller?
  merchant                 Merchant?
  roomsCreated             Room[]              @relation("RoomCreator")
  roomSeatOccupations      RoomSeat[]
  giftTransactionsSent     GiftTransaction[]   @relation("GiftSender")
  giftTransactionsReceived GiftTransaction[]   @relation("GiftRecipient")
  userAssets               UserAsset[]
  gameTransactions         GameTransaction[]
  onlineRecharges          OnlineRecharge[]
  offlineRecharges         OfflineRecharge[]
  withdrawalRequests       WithdrawalRequest[]
  coinRefunds              CoinRefund[]
  p2pAsSeller              P2PEscrowOrder[]    @relation("EscrowSeller")
  p2pAsBuyer               P2PEscrowOrder[]    @relation("EscrowBuyer")
  posts                    Post[]
  comments                 Comment[]
  likes                    Like[]
  following                Follow[]            @relation("Follower")
  followers                Follow[]            @relation("Following")
  sentMessages             Message[]           @relation("MessageSender")
  notifications            Notification[]
  supportTickets           SupportTicket[]
  reportsSubmitted         Report[]            @relation("Reporter")
  reportsReceived          Report[]            @relation("ReportedUser")

  @@index([status])
  @@index([countryCode])
  @@index([userType])
}

model UserProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String?
  level               Int      @default(1)
  experiencePoints    BigInt   @default(0)
  signature           String?
  totalSpentCoins     BigInt   @default(0)
  totalEarnedDiamonds BigInt   @default(0)
  vipLevel            Int      @default(0)
  svipLevel           Int      @default(0)
  nobleRank           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String?
  platform    String // "android", "ios", "web"
  macAddress  String?
  deviceModel String?
  appVersion  String?
  isBlocked   Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([deviceToken])
}

model OTPVerification {
  id          String     @id @default(uuid())
  destination String // Phone number or email
  codeHash    String
  purpose     OTPPurpose
  attempts    Int        @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  isUsed      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
}

model LoginAttempt {
  id            String   @id @default(uuid())
  identifier    String // Phone, email, or username
  ipAddress     String?
  userAgent     String?
  isSuccessful  Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([identifier])
  @@index([ipAddress])
}

// ==========================================
// DOMAIN C: ADMIN & RBAC (61 PERMISSIONS)
// ==========================================

model Admin {
  id           String      @id @default(uuid())
  name         String
  username     String      @unique
  email        String      @unique
  passwordHash String
  status       AdminStatus @default(ACTIVE)
  isSuperAdmin Boolean     @default(false)
  isOwner      Boolean     @default(false)
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  requestedApprovals  AdminApproval[]           @relation("ApprovalRequester")
  reviewedApprovals   AdminApproval[]           @relation("ApprovalReviewer")
  auditLogs           AuditLog[]
  assignedTickets     SupportTicket[]
  moduleAccess        AdminModuleAccess[]
  ownerGrants         OwnerGrant[]
  teamMemberships     TeamMember[]
  permissionOverrides AdminPermissionOverride[]

  @@index([status])
  @@index([isOwner])
}

model AdminModuleAccess {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  module    String
  grantedBy String
  grantedAt DateTime @default(now())

  @@unique([adminId, module])
  @@index([adminId])
}

model OwnerGrant {
  id           String    @id @default(uuid())
  adminId      String
  admin        Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  grantType    String
  module       String?
  permissionId String?
  canApprove   Boolean   @default(false)
  grantedBy    String
  grantedAt    DateTime  @default(now())
  revokedBy    String?
  revokedAt    DateTime?
  status       String    @default("ACTIVE")
  expiresAt    DateTime?
  reason       String?

  @@index([adminId, status])
}

model AdminPermissionOverride {
  id           String   @id @default(uuid())
  adminId      String
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permissionId String
  overrideType String   // "GRANT" or "REVOKE"
  grantedBy    String
  createdAt    DateTime @default(now())

  @@unique([adminId, permissionId])
  @@index([adminId])
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String
  adminId    String
  roleInTeam String?
  createdAt  DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([teamId, adminId])
  @@index([teamId])
  @@index([adminId])
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admins      Admin[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id // Canonical ID e.g., "USERS.VIEW", "USERS.UPDATE"
  module      String // e.g., "users", "finance"
  label       String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminApproval {
  id               String              @id @default(uuid())
  requesterId      String
  requester        Admin               @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approverId       String?
  approver         Admin?              @relation("ApprovalReviewer", fields: [approverId], references: [id])
  module           String // e.g., "wallet", "games", "hosts"
  actionType       String // e.g., "BALANCE_ADJUSTMENT", "RTP_CHANGE"
  status           AdminApprovalStatus @default(PENDING)
  beforeStateJson  Json?
  payloadStateJson Json
  rejectionReason  String?
  auditLogId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([requesterId])
}

model AuditLog {
  id              String   @id @default(uuid())
  adminId         String
  admin           Admin    @relation(fields: [adminId], references: [id])
  adminName       String
  action          String
  targetEntity    String
  targetEntityId  String?
  beforeStateJson Json?
  afterStateJson  Json?
  diffStateJson   Json?
  reason          String?
  ipAddress       String?
  approvalId      String?
  createdAt       DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetEntity, targetEntityId])
}

// ==========================================
// DOMAIN D & E: HOSTS, AGENCIES & BD CENTERS
// ==========================================

model HostProfile {
  id                       String     @id @default(uuid())
  userId                   String     @unique
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostType                 HostType   @default(LIVE_HOST)
  hostStatus               HostStatus @default(APPLIED)
  hostLevel                Int        @default(1)
  agencyId                 String?
  agency                   Agency?    @relation(fields: [agencyId], references: [id])
  bdCenterId               String?
  bdCenter                 BDCenter?  @relation(fields: [bdCenterId], references: [id])
  totalLiveHoursMonth      Float      @default(0.0)
  totalDiamondsEarnedMonth BigInt     @default(0)
  targetDaysAchieved       Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  agencyMemberships AgencyMember[]
  pkEventsAsHostA   PKEvent[]      @relation("PKHostA")
  pkEventsAsHostB   PKEvent[]      @relation("PKHostB")

  @@index([hostStatus])
  @@index([hostType])
}

model HostApplication {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostType        HostType
  idCardFrontUrl  String
  idCardBackUrl   String
  videoSampleUrl  String?
  status          HostStatus @default(APPLIED)
  reviewerAdminId String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@index([status])
}

model HostLevelConfig {
  id                   String   @id @default(uuid())
  level                Int
  hostType             HostType
  targetDiamonds       BigInt
  basicSalaryUSD       Decimal  @db.Decimal(12, 2)
  dailyHoursRequired   Float
  daysRequiredPerMonth Int
  createdAt            DateTime @default(now())

  @@unique([level, hostType])
}

model Agency {
  id             String       @id @default(uuid())
  agencyName     String
  agencyCode     String       @unique
  agencyType     AgencyType   @default(LIVE_AGENCY)
  ownerUserId    String
  owner          User         @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  bdCenterId     String?
  bdCenter       BDCenter?    @relation(fields: [bdCenterId], references: [id])
  commissionRate Float        @default(20.0) // Percentage
  status         AgencyStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  hosts   HostProfile[]
  members AgencyMember[]

  @@index([status])
}

model AgencyMember {
  id            String       @id @default(uuid())
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostProfileId String?
  hostProfile   HostProfile? @relation(fields: [hostProfileId], references: [id])
  joinedAt      DateTime     @default(now())

  @@unique([agencyId, userId])
  @@index([userId])
}

model BDCenter {
  id                      String   @id @default(uuid())
  centerName              String
  regionCode              String   @default("US")
  managerUserId           String
  manager                 User     @relation("BDManager", fields: [managerUserId], references: [id])
  currentTier             BDTier   @default(BRONZE)
  baseSalaryUSD           Decimal  @default(500.00) @db.Decimal(12, 2)
  totalGroupDiamondsMonth BigInt   @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  agencies Agency[]
  hosts    HostProfile[]
  invites  BDInvite[]
}

model BDInvite {
  id             String         @id @default(uuid())
  bdCenterId     String
  bdCenter       BDCenter       @relation(fields: [bdCenterId], references: [id], onDelete: Cascade)
  targetUserId   String
  targetUser     User           @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  invitationCode String         @unique
  status         BDInviteStatus @default(PENDING)
  sentAt         DateTime       @default(now())
  acceptedAt     DateTime?

  @@index([bdCenterId, status])
}

// ==========================================
// DOMAIN F: RESELLERS & MERCHANTS
// ==========================================

model CoinSeller {
  id                   String           @id @default(uuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  resellerBalanceCoins BigInt           @default(0)
  profitMarginPercent  Float            @default(10.0)
  creditLimitUSD       Decimal          @default(1000.00) @db.Decimal(12, 2)
  sellerStatus         CoinSellerStatus @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  p2pOrders P2PEscrowOrder[]
}

model Merchant {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  apiKeyHash        String         @unique
  apiSecretHash     String
  monthlyQuotaCoins BigInt         @default(1000000)
  totalSpentUSD     Decimal        @default(0.00) @db.Decimal(14, 2)
  status            MerchantStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// ==========================================
// DOMAIN G & H: WALLETS, LEDGER & FINANCE
// ==========================================

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinBalance        BigInt   @default(0)
  diamondBalance     BigInt   @default(0)
  sellerBalanceCoins BigInt   @default(0)
  escrowLockedCoins  BigInt   @default(0)
  totalRechargedUSD  Decimal  @default(0.00) @db.Decimal(14, 2)
  totalWithdrawnUSD  Decimal  @default(0.00) @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ledgerEntries WalletLedger[]
}

model WalletLedger {
  id              String           @id @default(uuid())
  walletId        String
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactionType WalletLedgerType
  coinDelta       BigInt           @default(0)
  diamondDelta    BigInt           @default(0)
  usdDelta        Decimal          @default(0.00) @db.Decimal(12, 2)
  balanceBefore   Json // { coins, diamonds, sellerCoins, escrowLocked }
  balanceAfter    Json // { coins, diamonds, sellerCoins, escrowLocked }
  referenceId     String?
  createdAt       DateTime         @default(now())

  @@index([walletId, createdAt(sort: Desc)])
  @@index([transactionType])
}

model RechargePlan {
  id         String   @id @default(uuid())
  coinAmount BigInt
  priceUSD   Decimal  @db.Decimal(10, 2)
  bonusCoins BigInt   @default(0)
  badgeText  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model OnlineRecharge {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway       String // "STRIPE", "BRAINTREE", "PAYPAL"
  gatewayTxId   String         @unique
  amountUSD     Decimal        @db.Decimal(10, 2)
  coinsCredited BigInt
  status        RechargeStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  @@index([userId])
}

model OfflineRecharge {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUSD       Decimal               @db.Decimal(10, 2)
  bankName        String
  receiptPhotoUrl String
  transactionRef  String                @unique
  status          OfflineRechargeStatus @default(PENDING)
  reviewerAdminId String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())

  @@index([userId])
  @@index([status])
}

model WithdrawalRequest {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUSD       Decimal          @db.Decimal(10, 2)
  diamondsDebited BigInt
  payoutMethod    String // "BANK", "PAYPAL", "PAYONEER"
  accountDetails  Json
  status          WithdrawalStatus @default(PENDING)
  reviewerAdminId String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([status])
}

model CoinRefund {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAmount         BigInt
  disputeReason      String
  status             CoinRefundStatus @default(PENDING)
  processedByAdminId String?
  createdAt          DateTime         @default(now())

  @@index([userId])
}

model P2PEscrowOrder {
  id                String       @id @default(uuid())
  sellerId          String
  seller            CoinSeller   @relation(fields: [sellerId], references: [id])
  buyerUserId       String
  buyer             User         @relation("EscrowBuyer", fields: [buyerUserId], references: [id])
  sellerUserId      String
  sellerUser        User         @relation("EscrowSeller", fields: [sellerUserId], references: [id])
  coinAmount        BigInt
  priceUSD          Decimal      @db.Decimal(10, 2)
  escrowStatus      EscrowStatus @default(LOCKED)
  paymentReceiptUrl String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([sellerId])
  @@index([buyerUserId])
  @@index([escrowStatus])
}

// ==========================================
// DOMAIN I: ROOMS & REAL-TIME ENTITIES
// ==========================================

model Room {
  id                  String       @id @default(uuid())
  creatorUserId       String
  creator             User         @relation("RoomCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  title               String
  coverImageUrl       String?
  roomType            RoomType     @default(LIVE_VIDEO)
  category            RoomCategory @default(CHAT)
  isPrivate           Boolean      @default(false)
  roomPin             String?
  isPinnedTop         Boolean      @default(false)
  pinnedPosition      Int? // 1, 2, or 3
  currentViewersCount Int          @default(0)
  status              RoomStatus   @default(LIVE)
  createdAt           DateTime     @default(now())
  endedAt             DateTime?

  seats             RoomSeat[]
  moderationActions RoomModeration[]
  giftTransactions  GiftTransaction[]
  pkEventsAsRoomA   PKEvent[]         @relation("PKRoomA")
  pkEventsAsRoomB   PKEvent[]         @relation("PKRoomB")

  @@index([roomType, status, isPinnedTop])
  @@index([creatorUserId])
}

model RoomSeat {
  id             String   @id @default(uuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seatIndex      Int // 0 to 7
  occupiedUserId String?
  occupiedUser   User?    @relation(fields: [occupiedUserId], references: [id])
  isMuted        Boolean  @default(false)
  isLocked       Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([roomId, seatIndex])
}

model RoomModeration {
  id           String               @id @default(uuid())
  roomId       String
  room         Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  targetUserId String
  actionType   ModerationActionType
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())

  @@index([roomId])
}

// ==========================================
// DOMAIN J: VIRTUAL ECONOMY & DYNAMIC ASSETS
// ==========================================

model Gift {
  id                 String       @id @default(uuid())
  name               String
  coinValue          BigInt
  iconUrl            String
  svgaAssetUrl       String?
  giftCategory       GiftCategory @default(POPULAR)
  isAnimated         Boolean      @default(false)
  isFullScreen       Boolean      @default(false)
  platformCutPercent Float        @default(45.0)
  hostCutPercent     Float        @default(35.0)
  agencyCutPercent   Float        @default(12.0)
  roomCutPercent     Float        @default(8.0)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  transactions GiftTransaction[]
}

model GiftTransaction {
  id              String   @id @default(uuid())
  giftId          String
  gift            Gift     @relation(fields: [giftId], references: [id])
  senderUserId    String
  sender          User     @relation("GiftSender", fields: [senderUserId], references: [id])
  recipientUserId String
  recipient       User     @relation("GiftRecipient", fields: [recipientUserId], references: [id])
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])
  giftCount       Int      @default(1)
  totalCoins      BigInt
  hostDiamonds    BigInt
  createdAt       DateTime @default(now())

  @@index([senderUserId])
  @@index([recipientUserId])
  @@index([roomId])
}

model Asset {
  id                   String           @id @default(uuid())
  name                 String
  assetType            AssetType
  assetSubcategory     AssetSubcategory @default(STATIC)
  thumbnailUrl         String
  staticFileUrl        String?
  animationFileUrl     String?
  videoFileUrl         String?
  audioFileUrl         String?
  durationSeconds      Float?
  defaultVolumePercent Float            @default(100.0)
  priceCoins           BigInt           @default(0)
  validDays            Int              @default(30)
  roomAvailability     RoomAvailability @default(BOTH)
  isVipExclusive       Boolean          @default(false)
  minVipLevelRequired  Int              @default(0)
  minNobleRankRequired String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())

  userAssets UserAsset[]

  @@index([assetType, isActive])
}

model UserAsset {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  isEquipped Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, isEquipped])
  @@index([userId, assetId])
}

// ==========================================
// DOMAIN K & L: MINI-GAMES, HOUSE EDGE & PK BATTLES
// ==========================================

model Game {
  id        String   @id @default(uuid())
  gameKey   GameKey  @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  configs GameConfig[]
  rounds  GameRound[]
}

model GameConfig {
  id                         String   @id @default(uuid())
  gameId                     String
  game                       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  prizeProbabilitiesJson     Json // Array of probability floats
  prizePayoutMultipliersJson Json // Array of payout multipliers
  computedRTP                Float // Computed Return To Player %
  computedHouseEdge          Float // Computed House Edge % (1 - RTP)
  minBetCoins                BigInt   @default(10)
  maxBetCoins                BigInt   @default(100000)
  createdAt                  DateTime @default(now())

  @@index([gameId])
}

model GameRound {
  id                String          @id @default(uuid())
  gameId            String
  game              Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roundNumber       BigInt
  totalBetsCoins    BigInt          @default(0)
  totalPayoutsCoins BigInt          @default(0)
  roundOutcomeJson  Json
  status            GameRoundStatus @default(IN_PROGRESS)
  createdAt         DateTime        @default(now())
  endedAt           DateTime?

  transactions GameTransaction[]

  @@index([gameId])
}

model GameTransaction {
  id          String    @id @default(uuid())
  roundId     String
  round       GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  betCoins    BigInt
  payoutCoins BigInt    @default(0)
  outcomeType String
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([roundId])
}

model PKEvent {
  id               String      @id @default(uuid())
  roomAId          String
  roomA            Room        @relation("PKRoomA", fields: [roomAId], references: [id])
  roomBId          String
  roomB            Room        @relation("PKRoomB", fields: [roomBId], references: [id])
  hostAUserId      String
  hostA            HostProfile @relation("PKHostA", fields: [hostAUserId], references: [id])
  hostBUserId      String
  hostB            HostProfile @relation("PKHostB", fields: [hostBUserId], references: [id])
  durationSeconds  Int         @default(300)
  hostAScore       BigInt      @default(0)
  hostBScore       BigInt      @default(0)
  winnerHostUserId String?
  status           PKStatus    @default(COUNTDOWN)
  createdAt        DateTime    @default(now())
  endedAt          DateTime?

  @@index([roomAId])
  @@index([roomBId])
}

// ==========================================
// DOMAIN M: SOCIAL & NOTIFICATIONS
// ==========================================

model Post {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  mediaUrls     Json? // Array of image/video URLs
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  comments Comment[]
  likes    Like[]

  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Follow {
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String // "SYSTEM", "GIFT", "PK", "WALLET"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==========================================
// DOMAIN N: SUPPORT, MODERATION & POLICIES
// ==========================================

model SupportTicket {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  message         String
  status          SupportTicketStatus @default(OPEN)
  assignedAdminId String?
  assignedAdmin   Admin?              @relation(fields: [assignedAdminId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model Report {
  id               String       @id @default(uuid())
  reporterUserId   String
  reporter         User         @relation("Reporter", fields: [reporterUserId], references: [id])
  reportedUserId   String?
  reportedUser     User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedRoomId   String?
  violationType    String
  screenshotUrl    String?
  status           ReportStatus @default(PENDING)
  adminActionTaken String?
  createdAt        DateTime     @default(now())

  @@index([reporterUserId])
  @@index([status])
}

model ModerationAction {
  id         String   @id @default(uuid())
  adminId    String
  targetType String // "USER", "ROOM", "POST"
  targetId   String
  action     String
  reason     String
  createdAt  DateTime @default(now())
}

model Restriction {
  id        String          @id @default(uuid())
  targetId  String // User ID or Device MAC
  type      RestrictionType
  reason    String
  expiresAt DateTime?
  createdAt DateTime        @default(now())
}

model BlockedDevice {
  id          String   @id @default(uuid())
  deviceToken String   @unique
  reason      String
  createdAt   DateTime @default(now())
}

model BlockedIP {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model Policy {
  id          String   @id @default(uuid())
  policyType  String   @unique // "ECONOMY", "LIVE_HOST", "AUDIO_HOST", "RESELLER"
  version     String
  description String?
  createdAt   DateTime @default(now())

  versions PolicyVersion[]
}

model PolicyVersion {
  id            String   @id @default(uuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version       String
  summary       String
  configJson    Json
  approvedBy    String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([policyId, createdAt(sort: Desc)])
}

model PolicyConfiguration {
  id            String    @id @default(uuid())
  key           String    @unique
  valueJson     Json
  status        String    @default("ACTIVE") // "ACTIVE" or "DISABLED"
  disabledAt    DateTime?
  autoRestoreAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([status, autoRestoreAt])
}

model PaymentProvider {
  id         String   @id @default(uuid())
  name       String   @unique // "STRIPE", "BRAINTREE", "PAYPAL"
  apiKey     String
  apiSecret  String
  webhookUrl String?
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}
