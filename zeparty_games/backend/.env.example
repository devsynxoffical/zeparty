# ZeParty Games backend - development values only, never commit real secrets
PORT=8080
LOG_LEVEL=info

# Postgres. Leave DATABASE_URL empty to run with the in-memory repositories (dev/test only)
DATABASE_URL=postgres://zeparty:zeparty_dev_password@localhost:5432/zeparty_games

# Redis for room state across multiple backend instances. Optional, in-memory store when empty
REDIS_URL=

# Auth adapter: "mock" issues dev tokens from /auth/dev-login, "jwt" verifies tokens issued by the ZeParty host backend
# Set to "jwt" when running behind the ZeParty host backend (tokens from GET /v1/games/token)
AUTH_ADAPTER=mock
JWT_SECRET=dev-only-change-me-7f3c1a9e
JWT_ISSUER=zeparty

# Admin API key for /admin/* configuration endpoints (dev value)
ADMIN_API_KEY=dev-admin-key-2f8e

# Turn timer defaults (seconds)
DEFAULT_TURN_TIMEOUT_SECONDS=30
DISCONNECT_GRACE_SECONDS=60
